[node name="Body" type="Label" parent="InfoOverlay/Center/Panel/VBox"]
custom_minimum_size = Vector2(200, 200)
layout_mode = 2
theme_type_variation = &"BodyLabel"
theme_override_font_sizes/font_size = 19
text = "操作方式
← 刹车 / 后退，→ 加速前进。

游戏规则
撞上障碍会掉落乘客，乘客归零、缆车掉出游戏外、超过游戏时间限制、都会立即挑战失败；
安全抵达终点即通关，成绩先比丢失乘客数量，再比用时。

关卡工坊
在“关卡工坊”中可自由拼接轨道、放置各种障碍、设置起点和终点；
再给自己的关卡命名、设置时间，手动通关一次后方可上传广场，审核通过后，你的关卡将可以让其他玩家体验；

个人主页
可自定义昵称，显示ID、主线进度、星星收藏、缆车收藏等各种信息；
昵称与进度随本地存档保存。"
autowrap_mode = 2

